# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

*.hprof
# System files
.DS_Store
*.pem
*.key

# Python
__pycache__/
*.pyc
venv/
.venv/

# ===== FRONTEND =====

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.yarn/

# Expo
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# Metro
frontend/.metro-cache/
frontend/.metro-health-check*

# Native Mobile
frontend/ios/Pods/
frontend/ios/build/
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/*.iml
frontend/android/.cxx/
frontend/.kotlin/
frontend/*.orig.*
frontend/*.jks
frontend/*.p8
frontend/*.p12
frontend/*.mobileprovision

# Build artifacts
frontend/*.jsbundle

# Typescript
frontend/*.tsbuildinfo

# Environment files
.env
.env.*
frontend/.env*.local
*credentials.json
!/.env.example

# Emergent / Generated files
.emergent/
repopack-output.txt
test_reports/
test_result.md
memory/
design_guidelines.json
frontend/.tmp_download_test/
frontend/app-example/
